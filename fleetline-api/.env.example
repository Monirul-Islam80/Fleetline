# Every setting has a working default for local runs. Production must set the ones marked REQUIRED.

ADDR=:8080
DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:3000
FLEET_TIME_ZONE=Europe/London
OPERATOR_NAME=Demo Operator

# Dispatch engine
OFFER_TIMEOUT=15s
MAX_MISSES_BEFORE_BID=3
ENGINE_TICK=1s
PUBLISH_INTERVAL=250ms
POSITION_FLUSH=2s
TRACK_RETENTION=72h

# Demo
SEED_ON_EMPTY=true
SIM_DRIVERS=true            # set false once real driver apps connect
SIM_SPEED_FACTOR=8
SIM_APP_BOOKINGS_EVERY=40s  # 0 turns the passenger-app demo feed off

# Security
AUTH_REQUIRED=false         # REQUIRED true in production
API_KEYS=                   # comma-separated operator keys (X-API-Key)
TOKEN_SECRET=change-me      # REQUIRED: long random string
WEBHOOK_SECRET=             # REQUIRED for telephony webhooks in production
DEMO_DRIVER_PIN=0000        # placeholder until per-driver credentials exist
DEMO_USER_CODE=1234         # placeholder until SMS verification exists
LOG_LEVEL=info
