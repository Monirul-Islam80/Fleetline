# Mock mode (default): the console runs on seeded data in the browser. Nothing to set.

# Live mode: talk to the Go backend (fleetline-api).
NEXT_PUBLIC_API_MODE=live
# /api is proxied to BACKEND_URL/api/v1 by next.config.ts, so the console and API share an origin.
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://localhost:8080
# WebSockets go straight to the API (allowed by its ALLOWED_ORIGINS).
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
